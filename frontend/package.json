{
  "name": "esms-frontend",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@tanstack/react-query": "^5.105.3",
    "axios": "^1.13.4",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "material-symbols": "0.48.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.12.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "espree": "10.4.0",
    "fontverter": "2.0.0",
    "globals": "^15.14.0",
    "harfbuzzjs": "1.6.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.4.2",
    "subset-font": "2.9.0",
    "tailwindcss": "^4.0.0",
    "terser": "^5.46.0",
    "vite": "^7.2.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "26.x"
  },
  "allowScripts": {
    "esbuild": true
  }
}
