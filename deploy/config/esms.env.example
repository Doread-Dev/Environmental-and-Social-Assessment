# ESMS server settings: copy to backend/.env on the server (the install scripts do it and fill in
# JWT_SECRET). Never commit the real file. Lines starting with # are comments.

# ---- App -------------------------------------------------------------------------------------
NODE_ENV=production
# The port Node listens on. IIS/nginx forwards to it.
PORT=3000
# 127.0.0.1 = reachable only from this machine, i.e. only through IIS/nginx (recommended).
HOST=127.0.0.1
# One proxy hop (IIS or nginx on this machine) in front of the app. Leave empty when nothing is in
# front, or clients could fake their address.
TRUST_PROXY=true
# Long random secret, at least 32 characters (the install scripts generate one). Changing it signs
# everybody out.
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Empty on the server: the app and the API are served from the same address (no CORS).
FRONTEND_URL=

# ---- Database --------------------------------------------------------------------------------
# Single-node replica set rs0 (transactions on), see deploy/README.md.
MONGODB_URI=mongodb://127.0.0.1:27017/esms?replicaSet=rs0

# ---- Files -----------------------------------------------------------------------------------
# Uploaded project documents and the reference library (library/). Back it up (BACKUP_DIR).
#   Windows: D:\ESMS\uploads      Linux: /var/lib/esms/uploads
UPLOADS_DIR=
# Largest upload in MB. IIS/nginx must allow a little more (deploy/proxy/).
MAX_UPLOAD_MB=10

# ---- Backups ---------------------------------------------------------------------------------
# A folder on a SECOND DISK or a NETWORK SHARE, never the database disk (the backup refuses it).
#   Windows: E:\ESMS-backups  or  \backup-server\esms        Linux: /mnt/backup/esms
BACKUP_DIR=
# Days to keep (the newest backup is always kept).
BACKUP_KEEP_DAYS=30
# The MongoDB Database Tools' bin folder (mongodump, mongorestore), when they are not on the PATH.
#   Windows: C:\Program Files\MongoDB\Tools\100\bin        Linux: usually on the PATH, leave empty
MONGODB_TOOLS_DIR=
