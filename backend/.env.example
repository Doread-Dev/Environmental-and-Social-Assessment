# Server
PORT=3000
# Use NODE_ENV=production on hosting (Render/Railway); development for local
NODE_ENV=development

# Database (required)
MONGODB_URI=your-mongodb-url-here

# Auth (required). Use a strong random string, 32+ characters.
JWT_SECRET=your-strong-secret-here
# Optional: token expiry (default 12h)
JWT_EXPIRES_IN=12h

# CORS: frontend origin. Required in production; in development defaults to http://localhost:5173
FRONTEND_URL=http://localhost:5173
