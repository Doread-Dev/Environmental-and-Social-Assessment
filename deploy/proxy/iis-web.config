<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS in front of ESMS (Windows Server): HTTPS for the users, plain HTTP to Node on 127.0.0.1:3000.
  Needs the IIS modules "URL Rewrite" and "Application Request Routing" (ARR), both offline
  installers (deploy/INSTALL-WINDOWS.md, step 7). Put this file as web.config in the root folder of
  an empty IIS site (e.g. C:\inetpub\esms) that has the HTTPS binding with the certificate.
  Once per server (an administrator PowerShell):
    & "$env:windir\system32\inetsrv\appcmd.exe" set config -section:system.webServer/proxy /enabled:"True" /preserveHostHeader:"True" /reverseRewriteHostInResponseHeaders:"False" /timeout:"00:02:00" /commit:apphost
    & "$env:windir\system32\inetsrv\appcmd.exe" set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_PROTO']" /commit:apphost
  In backend\.env: HOST=127.0.0.1, TRUST_PROXY=true (one hop: this IIS; ARR adds X-Forwarded-For).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- HTTP → HTTPS -->
        <rule name="ESMS HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Everything else to Node: the app, /api/v1 and /health -->
        <rule name="ESMS reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Uploads: MAX_UPLOAD_MB (10) plus room for the form, and the API's 10 MB JSON limit:
             12 MB in bytes. Raise it together with MAX_UPLOAD_MB. -->
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>

    <!-- Security headers (CSP, HSTS, ...) come from the app; IIS adds none of its own. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Error pages come from the app (JSON for the API), not from IIS. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
