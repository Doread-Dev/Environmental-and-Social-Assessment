# Runs esms-backup.service every day at 02:00. Persistent: a run missed while the server was off
# happens at the next start. List: systemctl list-timers esms-backup.timer
[Unit]
Description=ESMS daily backup

[Timer]
OnCalendar=*-*-* 02:00:00
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
