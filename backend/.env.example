# Server
PORT=3000
# development for local work; production on the server (deploy/config/esms.env.example has the
# server template)
NODE_ENV=development

# Database (required)
MONGODB_URI=your-mongodb-url-here

# Auth (required). Use a strong random string, 32+ characters.
JWT_SECRET=your-strong-secret-here
# Optional: token expiry (default 12h)
JWT_EXPIRES_IN=12h

# CORS: the frontend origin when it runs elsewhere (Vite on :5173, Vercel). Unset = no CORS at all
# (the server serves the app and the API from one origin).
FRONTEND_URL=http://localhost:5173

# Reverse proxy (IIS/nginx) in front of the API: "true" = trust one hop, or a hop count /
# IP list. Leave unset (off) when clients connect directly, or they can spoof their IP.
# TRUST_PROXY=true

# Listen address: 127.0.0.1 behind IIS/nginx on the same machine. Default: every interface.
# HOST=127.0.0.1

# Project files and the library. Default backend/uploads. Backups include this folder.
# UPLOADS_DIR=/var/esms/uploads
# Max size of one uploaded file in MB (default 10)
# MAX_UPLOAD_MB=10

# Backups (scripts/backup.js, deploy/): a second disk or a network share, never the database disk.
# BACKUP_DIR=E:\ESMS-backups
# BACKUP_KEEP_DAYS=30
# MONGODB_TOOLS_DIR=C:\Program Files\MongoDB\Tools\100\bin
