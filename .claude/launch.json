{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "e2e-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "e2e/scripts/start-server.mjs"
      ],
      "port": 3100
    },
    {
      "name": "design-playgrounds",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const root=p.resolve('plan/design');h.createServer((q,r)=>{const file=p.join(root,decodeURIComponent(q.url.split('?')[0])==='/'?'foundations.html':decodeURIComponent(q.url.split('?')[0]));if(!file.startsWith(root)){r.writeHead(403);return r.end()}f.readFile(file,(e,d)=>{if(e){r.writeHead(404);return r.end('not found')}r.writeHead(200,{'Content-Type':file.endsWith('.html')?'text/html; charset=utf-8':'application/octet-stream','Cache-Control':'no-store'});r.end(d)})}).listen(5510,'127.0.0.1')"
      ],
      "port": 5510
    }
  ]
}
